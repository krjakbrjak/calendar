    "description": "Simple calendar widget",
    "main": "dist/main.js",
    "module": "dist/main.mjs",
    "exports": {
        ".": {
            "import": "./dist/main.mjs",
            "require": "./dist/main.js"
        }
    },
    "dependencies": {
        "normalize.css": "^8.0.1"
    },
    "peerDependencies": {
        "prop-types": "^15.7.2",
        "react": ">=16.8.3",
        "react-dom": ">=16.8.3"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^12.1.5",
        "@testing-library/user-event": "^14.6.3",
        "babel-eslint": "^10.1.0",
        "eslint": "^7.7.0",
        "eslint-config-airbnb": "^18.2.0",
        "eslint-plugin-import": "^2.22.0",
        "eslint-plugin-jsx-a11y": "^6.3.1",
        "eslint-plugin-react": "^7.20.6",
        "jsdoc": "^3.6.5",
        "jsdom": "^29.1.1",
        "prop-types": "^15.7.2",
        "react": "^16.13.1",
        "react-dom": "^16.13.1",
        "vite": "^8.2.0",
        "vite-plugin-css-injected-by-js": "^5.0.2",
        "vitest": "^4.1.10"
    },
    "scripts": {
