{
    "name": "@krjakbrjak/calendar",
    "version": "0.1.0",
    "description": "Simple calendar widget",
    "main": "dist/main.cjs",
    "module": "dist/main.mjs",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/main.mjs",
            "require": "./dist/main.cjs"
        }
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "jsdom": "^30",
        "oxlint": "^1.77.0",
        "playwright-core": "^1.62.1",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "^7.0.2",
        "vite": "^8.2.0",
        "vite-plugin-css-injected-by-js": "^5.0.2",
        "vitest": "^4.1.10",
        "yargs": "^18.1.0"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "prepack": "yarn build",
        "lint": "oxlint src",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "record:demo": "node scripts/record-demo.mjs --frames .frames --url http://localhost:9001 && ffmpeg -y -framerate 15 -i .frames/%04d.png -vf scale=620:-1:flags=lanczos -plays 0 -f apng calendar_demo.png"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/krjakbrjak/calendar.git"
    },
    "keywords": [
        "calendar",
        "es6",
        "react"
    ],
    "author": "Nikita Vakula",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/krjakbrjak/calendar/issues"
    },
    "homepage": "https://github.com/krjakbrjak/calendar#readme",
    "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
    "types": "dist/index.d.ts"
}
